DATABASE_URL=postgresql+psycopg://traction:traction@localhost:5432/traction

# Generate a real value before deploying, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-only-change-me

# Set to true once served over HTTPS (e.g. behind a reverse proxy), so the
# session cookie is marked Secure. Leave false for local/plain-HTTP dev.
COOKIE_SECURE=false

# How many days of history the Activity page keeps (older entries are pruned).
ACTIVITY_RETENTION_DAYS=90

# --- Email (optional) ---
# Leave SMTP_HOST empty and the app sends no email. To enable it, set
# SMTP_HOST, SMTP_FROM_ADDRESS and BASE_URL; the rest depend on your mail relay.
# BASE_URL is the address people use to reach this app; it is used for links
# inside emails.
SMTP_HOST=
SMTP_PORT=587
# starttls (port 587), ssl (port 465) or none (a plain internal relay, e.g. port 25)
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=Traction
BASE_URL=
