DATABASE_URL=postgresql+psycopg://traction:traction@localhost:5432/traction

# Generate a real value before deploying, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-only-change-me

# Set to true once served over HTTPS (e.g. behind a reverse proxy), so the
# session cookie is marked Secure. Leave false for local/plain-HTTP dev.
COOKIE_SECURE=false

